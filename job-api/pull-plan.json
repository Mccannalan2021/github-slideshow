{
  "about": "Searches the get-jobs skill runs. Edit freely: add towns, keywords or slices. Results are saved to raw/<source>/ and imported with npm run import.",

  "window": {
    "daily": { "max_posted_minutes_ago": 4320, "import": "npm run import -- --since-days=3" },
    "week": { "max_posted_minutes_ago": 10080, "import": "npm run import -- --full" },
    "default": "daily",
    "notes": "Every normal run is 'daily': the last 3 days, added to the jobs already saved (duplicates are skipped). ZipRecruiter's 1440-minute (24 hour) filter returns no results, so the daily pull looks back 3 days. Use 'week' only when the user asks for the past week or sources/ is empty."
  },

  "ziprecruiter": {
    "notes": "Add max_posted_minutes_ago from the chosen window to every call. Max 5 jobs per call. Offset 0 and 5 return different jobs; every offset of 5 or more repeats the same 5, so each query yields at most 10. Split the search into narrow slices so together they cover everything. Do not pass conversation_id.",
    "base": { "location": "Red Deer, Alberta", "country_admin_code": "CA", "radius_miles": 25 },
    "offsets": [0, 5],
    "slices": {
      "employment_types": [["FULL_TIME"], ["PART_TIME"], ["CONTRACT"], ["TEMPORARY"], ["CONTRACT_TO_HIRE"], ["AS_NEEDED"], ["OTHER"], ["INTERNSHIP"]],
      "seniority_classes": [["NO_EXPERIENCE"], ["JUNIOR"], ["MID"], ["SENIOR"]],
      "type_x_seniority": { "employment_types": [["FULL_TIME"], ["PART_TIME"]], "seniority_classes": [["NO_EXPERIENCE"], ["JUNIOR"], ["MID"], ["SENIOR"]] },
      "salary_bands": [[0, 30000], [30000, 40000], [40000, 50000], [50000, 60000], [60000, 75000], [75000, 100000], [100000, 300000]],
      "location_types": [["REMOTE"], ["HYBRID"]],
