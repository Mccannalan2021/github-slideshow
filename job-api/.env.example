# Port the API listens on
PORT=3000

# Key your job app must send in the "x-api-key" header. Leave empty to disable auth (local dev only).
API_KEY=change-me

# "indeed" to call Indeed, "mock" to use built-in sample jobs for development
JOB_PROVIDER=mock

# Indeed partner API credentials (from https://developer.indeed.com after your app is approved)
INDEED_CLIENT_ID=
INDEED_CLIENT_SECRET=
INDEED_SCOPE=
# Override only if Indeed gives you different endpoints
INDEED_TOKEN_URL=https://apis.indeed.com/oauth/v2/tokens
INDEED_GRAPHQL_URL=https://apis.indeed.com/graphql

# Where the resume and application tracker are saved
DATA_DIR=./data
