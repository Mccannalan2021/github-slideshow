# Port the API listens on
PORT=3000

# Key your job app must send in the "x-api-key" header. Leave empty to disable auth (local dev only).
API_KEY=change-me

# ---- Job sources: fill in any you have. Every configured source is searched at once. ----
# With none configured, the API serves built-in sample Alberta jobs.

# Adzuna (free key): https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble (free key): https://jooble.org/api/about
JOOBLE_API_KEY=

# Government of Canada Job Bank open data CSV (file or folder), from
# https://open.canada.ca/data/en/dataset/ea639e28-c0fc-48bf-b5dd-b8899bd43072
JOBBANK_CSV=

# Indeed partner API (needs approval): https://developer.indeed.com
INDEED_CLIENT_ID=
INDEED_CLIENT_SECRET=
INDEED_SCOPE=

# Also include the sample jobs alongside real sources
INCLUDE_SAMPLE_JOBS=false

# ---- Tuning ----
# How long search results from each source are cached
CACHE_TTL_SECONDS=600
# Max jobs pulled from each source per search
PER_SOURCE_LIMIT=50

# Where the resume, applications, saved searches and job index are saved
DATA_DIR=./data

# Extra job snapshot files to load (comma separated). Every .json in sources/ is loaded automatically.
JOBS_FILES=
